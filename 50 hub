local function ToggleFly()
	FlyEnabled = not FlyEnabled
	if FlyEnabled then
		local BV = Instance.new("BodyVelocity", RootPart)
		BV.Name = "FlyVelocity"
		BV.MaxForce = Vector3.new(9e9, 9e9, 9e9)
		BV.Velocity = Vector3.zero

		local BG = Instance.new("BodyGyro", RootPart)
		BG.Name = "FlyGyro"
		BG.MaxTorque = Vector3.new(9e9, 9e9, 9e9)
		BG.P = 9e4

		task.spawn(function()
			while FlyEnabled and RootPart:FindFirstChild("FlyVelocity") do
				task.wait()
				local cam = workspace.CurrentCamera
				BV.Velocity = Vector3.zero
				BG.CFrame = cam.CFrame
			end
		end)
	else
		if RootPart:FindFirstChild("FlyVelocity") then RootPart.FlyVelocity:Destroy() end
		if RootPart:FindFirstChild("FlyGyro") then RootPart.FlyGyro:Destroy() end
	end
end

CreateMobileButton("FlyToggle", "✈️ Fly", UDim2.new(0.35,0,0.2,0), nil, ToggleFly)
