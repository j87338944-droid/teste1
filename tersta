            part.Transparency = State.invisible and 1 or 0
        end
    end
    
    return State.invisible
end

local function toggleMeTravar()
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChild("Humanoid")
    if not hrp or not hum then return false end
    
    if Connections.meTravar then
        Connections.meTravar:Disconnect()
        Connections.meTravar = nil
        State.meTravar = false
        
        -- Restaurar valores normais
        hrp.Anchored = false
        hum.PlatformStand = false
        return false
    end
    
    State.meTravar = true
    
    -- Proteção contínua - você pode andar normalmente mas está protegido
    Connections.meTravar = RunService.Heartbeat:Connect(function()
        local char = player.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            local hrp = char:FindFirstChild("HumanoidRootPart")
            
            if hum then
                -- Invencibilidade real
                hum.Health = hum.MaxHealth
                
                -- Proteção contra mudanças de estado
                if hum:GetState() == Enum.HumanoidStateType.Dead then
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
                
                -- Remove efeitos negativos
                hum.PlatformStand = false
                hum.Sit = false
            end
            
            if hrp then
                -- Proteção contra teleporte forçado
                hrp.Anchored = false -- VOCÊ pode andar
                
                -- Cancela velocidades extremas (ataques de outros)
                if hrp.AssemblyLinearVelocity.Magnitude > 100 then
                    hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                end
            end
        end
    end)
    
    return State.meTravar
end

