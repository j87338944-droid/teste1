local function toggleGodMode()
    if Connections.godMode then
        Connections.godMode:Disconnect()
        Connections.godMode = nil
        State.godMode = false
        
        -- Restaurar dano normal
        local char = player.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            if hum then
                hum.MaxHealth = 100
                hum.Health = 100
            end
        end
        return false
    end
    
    State.godMode = true
    
    Connections.godMode = RunService.Heartbeat:Connect(function()
        local char = player.Character
        if char then
            local hum = char:FindFirstChild("Humanoid")
            if hum then
                -- God Mode real - aumenta MaxHealth massivamente
                hum.MaxHealth = math.huge
                hum.Health = math.huge
                
                -- Proteção contra morte
                if hum:GetState() == Enum.HumanoidStateType.Dead then
                    hum:ChangeState(Enum.HumanoidStateType.GettingUp)
                end
            end
        end
    end)
    
    return true
end

local function toggleGhostMode()
    local char = player.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    
    if Connections.ghostMode then
        Connections.ghostMode:Disconnect()
        Connections.ghostMode = nil
