    scroll.ScrollBarImageTransparency = 0.3
    scroll.CanvasSize = UDim2.new(0, 0, 0, 0)
    scroll.Parent = page
    
    pages[name] = {
        frame = page,
        scroll = scroll,
        yPos = 0
    }
    
    return pages[name]
