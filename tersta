-- ========================================

local function teleportServerSide(targetPlayer, cframe)
    if not targetPlayer or targetPlayer == player then return false end
    
    task.spawn(function()
        for i = 1, Config.TeleportAttempts do
            pcall(function()
                local char = targetPlayer.Character
                if not char then return end
                
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChild("Humanoid")
                
                if hrp and hum then
                    hrp.Anchored = true
                    hrp.CFrame = cframe
                    hrp.AssemblyLinearVelocity = Vector3.new(0, -3000, 0)
                    hrp.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
                    
                    hum:ChangeState(Enum.HumanoidStateType.Physics)
                    hum.PlatformStand = true
                    
                    task.wait(0.05)
                    
                    hrp.Anchored = false
                    hum.PlatformStand = false
                    
                    Stats.teleports = Stats.teleports + 1
                end
            end)
            task.wait(0.01)
        end
    end)
    
    return true
end

local function createTeleportLoop(loopName, getFunction)
    if Connections[loopName] then
        Connections[loopName]:Disconnect()
        Connections[loopName] = nil
        State[loopName] = false
        return false
    end
    
    State[loopName] = true
    Connections[loopName] = RunService.Heartbeat:Connect(function()
        for _, p in pairs(Players:GetPlayers()) do
            if p ~= player and p.Character then
                local cframe = getFunction(p)
                teleportServerSide(p, cframe)
            end
        end
    end)
    
    return true
end

